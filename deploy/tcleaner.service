[Unit]
Description=tcleaner Discord bot
After=network-online.target
Wants=network-online.target

[Service]
User=tcleaner
WorkingDirectory=/opt/tcleaner
EnvironmentFile=/opt/tcleaner/.env
ExecStart=/usr/bin/node src/bot.js
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
